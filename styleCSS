@charset "UFT-8";

body{
    font-family: "Helvetica Neue","Arial","Hiragino Sans","Hiragino Kaku","Gothic ProN","Meiryo"sans-serif;
}  /*文字スタイルの指定*/
html {
    scroll-behavior: smooth;  /*リンク押したときの飛び方指定*/
}

/*----------header----------*/
header {
    background-image: url('/images/mainvisual.jpg');
    background-size: cover;  /*縦横比保持、縦横の小さいほうに合わせて背景画像表示*/
    height: 100vh;  /*高さに％は指定できない。100vhで画面いっぱい。vwもある*/
    position: relative;  /*背景画像を配置する基準点を指定*/
}

@media(min-width: 415px){  /*415以上の時sp-logoを非表示にする*/
    .sp_logo {
        display: none !important;
    }
}

h1 img {
    display: block;
    width: 80%;
    margin: 0 auto;
    position: absolute;  /*左上を基準点にする*/
    top: 50%;   /*これと*/
    left: 50%;  /*これで基準点を中央にする*/
    transform: translate(-50%,-50%);  /*上下左右中央配置*/
}

nav ul {
    display: flex;
    justify-content: end;  /*navは右配置*/
}

nav li {
    margin: 20px 30px 0 0;
}

nav a {
    color: white; 
    font-weight: bold;
}

nav a:hover {  /*nav状にカーソルが来た時、0.5秒かけて赤字になる*/
    color: red;
    transition: 0.5s;
}

/*----------parallax----------*/
.parallax_content {  /*パララックスの設定*/
    height: 250px;  /*💛h2*/
    background-position: center top;  /*背景画像の位置*/
    background-repeat: no-repeat;  /*画像を繰り返さない*/
    background-attachment: fixed;  /*背景画像の固定（スクロールしない）*/
    background-size: cover;  /*縦横比保持、縦横の小さいほうに合わせて背景画像表示*/
}

h2 {
    color: white;
    font-size: 65px;
    text-align: center;  /*文章の中央寄せ*/
    line-height: 250px;  /*💛同じ高さにすることで上下中央配置にする*/
    margin: 16px 0 100px 0;
}

/*------------main----------*/
.front_content {
    width: 1000px;  /*パララックスの画像以外の部分の設定*/
    margin: 0 auto;  /*ボックス自体を左右中央配置*/
    padding: 0 16px;  /*指定条件の左右16px*/
}

.parallax_content.img_bg_menu{
    background-image: url(/images/menu.jpg);
}
.parallax_content.img_bg_about{
    background-image: url(/images/about.jpg);
}
.parallax_content.img_bg_access{
    background-image: url(/images/access.jpg);
}
.parallax_content.img_bg_contact{
    background-image: url(/images/contact.jpg);
}

h3 {
    text-align: center;
    font-size: 40px;
    text-decoration: underline solid 5px red;
    margin-bottom: 60px;
}

section {
    margin-bottom: 150px;
}

/*----------menu----------*/
div.all {
    display: flex;
    justify-content: center;  /*要素の中央配置*/
}

div.menuL {  /*menuの左側*/
    padding-right: 40px;
    width: 50%;  /*横幅を50％にすることで横２分割にしている*/
    text-align: right;
    border-right: solid 1px black;  /*真ん中の線*/
}

div.menuR {  /*menuの右側*/
    padding-left: 40px;
    width: 50%;
    text-align: left;
}

h3.menu_coffee {
    margin-left: 50px;  /*ここらへんは微調整してるやつ*/
}

h3.menu_other {
    margin: 63px 0px 50px 0;
}

dt {  /*説明リストタグ*/
    width: 75%;
    display: inline-block;
    text-align: left;
    margin: 10px 0 10px 10px;
    border-bottom: dotted 1px black;
}

dd {
    width: 10%;
    display: inline-block;
    text-align: right;
    vertical-align: bottom;  /*文字の上下位置指定*/
}

/*----------about----------*/
/*-----画像-----*/
div.about_img img {
    width: 350px;  /*画像を入れる部分の幅を指定*/
}

div.about_img {
    display: flex;
    justify-content: center;  /*画像の上下中央配置*/
    position: relative;
    height: 350px;  /*画像を入れる部分の高さを指定*/
    width: 59%;  /*画像の大きさ*/
    margin: 0 auto;
}

img.img1 {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;  /*画像の重なり順を指定*/
}

img.img2 {
    position: absolute;
    bottom: 0;
    right: 0;
    z-index: 1;
}
/*-----テキスト-----*/
div.about_p {
    display: flex;
    flex-wrap: wrap;  /*親要素の幅を超える時複数行になる*/
    text-align: left;  /*文字は左寄せ*/
    width: 1000px;  /*指定条件*/
    margin: 0 auto;  /*ｐのボックス自体は左右中央配置*/
}

div.about_p p {
    margin: 40px 25px 0 25px;
    line-height:30px;
    font-size: 16px;
    width: 440px;
}

.aboutButton {  /*ボタン自体の配置*/
    text-align: center;
}

.aboutB {  /*ボタンの中身の設定*/
    display: inline-block;
    height: 50px;
    width: 150px;
    background-color: red;
    color: white;
    line-height: 50px;
    text-align: center;
    margin-top: 40px;  
}

.aboutB:hover {  /*ボタンの上にカーソルが乗ったとき*/
    display: inline-block;
    height: 50px;
    width: 150px;
    transition-duration: 0.5s;
    background-color: white;
    color: red;
    border: solid 1px red;
    letter-spacing: 2px;  /*字間広がる*/
}

/*-----------access------------*/
.googlemap{
    filter: grayscale(100%);  /*マップはグレスケ表示*/
    width: 1000px;
    height: 400px;
}

iframe {
    padding-bottom: 10px;
}

div.access_p p {
    padding: 10px 0;
}

/*----------contact----------*/
.contentI {
    text-align: center; /*ボックスの左右中央配置*/
}

.contact_item {
    font-weight: bold;
    padding: 15px;
    margin-top: 13px;
}

input.column,textarea {
    border: solid 1px black;  /*枠設定*/
    width: 1000px;
    padding: 3px;
    text-align: left;  /*回答が左寄せで入力される*/
}

select {
    -moz-appearance: menulist;  /*プルダウンメニューのｖがresetCSSで非表示になっている*/
    -webkit-appearance: menulist;  /*それを再表示するコード*/
    border: solid 1px black;
    width: 1000px;
    padding: 3px;
}

div.contactB {  /*送信ボタンの設定*/
    display: inline-block;
    height: 50px;
    width: 500px;
    background-color: red;
    color: white;
    border: solid 1px black;
    line-height: 50px;
    margin-top: 40px;
    box-shadow: 0 3px 3px black;
}

div.contactB:hover {  /*ボタンの上にカーソルが乗ったとき*/
    transition-duration: 0.5s;
    color: red;
    background-color: white;
}

div.contactB:active {  /*ボタンを押したとき*/
    background-color: red;
    color: white;
    margin-top: 42px;
    box-shadow: none;
}

/*----------footer----------*/
footer {
    text-align: center;
}

/*-------------------------------------------
SP 
-------------------------------------------*/

@media screen and (max-width: 415px) {   /*414px以下＝415pxより小さい時*/
    
/*----------header----------*/
    .pc_logo {
        display: none !important;  /*pc用のロゴを消す*/
    }

    header {
        background-position: center;
        height: 80vh;
        width: 100%;
    }

    h1 img {
        width: 80%;
    }

    nav li {
        margin: 22px 22px 0 0;
    }

/*----------parallax----------*/
    .parallax_content {  /*パララックス解除*/
        height: 80px;
        background-attachment: unset;
    }

    h2 {
        font-size: 30px;
        line-height: 80px;
        margin: 10px 0 30px 0;
    }

/*------------main----------*/
    .front_content {
        text-align: center;
        padding: 0;
        width: 100%;
    }

    h3 {
        font-size: 20px;
        margin: 30px 0;
    }

    section {
        margin-bottom: 90px;
    }

/*----------menu----------*/
    h3.menu_coffee {
        margin-left: 0;  /*不要な設定を一つずつ修正していく*/
    }

    h3.menu_other {
        margin: 20px 0;
    }

    div.all {
        display: block;
    }

    div.menuL {
        padding-right: 0;
        width: 100%;  /*50％で分割表示していたのを直している*/
        text-align: center;
        border-right: 0; /*0　none　…*/
    }

    div.menuR {
        padding-left: 0;
        width: 100%;
        text-align: center;
    }

    dt {   
        width: 80%;
        margin: 15px 0;
    }

    dd {
        width: 10%;
        display: inline-block;
        text-align: right;
        margin: 8px 0;
    }

/*----------about----------*/
    /*-----画像-----*/
    div.about_img img {
        width: 80%;  /*画像を表示できる幅の設定*/
    }

    div.about_img {
        height: 320px;
        width: 90%;
        margin-bottom: 30px;
    }

    /*-----テキスト-----*/
    div.about_p {
        flex-direction: column;  /*上から下に縦並び、上に配置*/
        width: 100%;
    }

    div.about_p p {
        margin: 0 auto;
        padding: 10px 0;
        width: 80%;
    }

/*-----------access------------*/
    .googlemap{
        width: 90%;
        height: 430px;
        margin: 0 auto;
    }

    iframe {
        padding-bottom: 20px;
    }

    div.access_p p {
        padding: 5px 11px;
        text-align: left;
    }

/*----------contact----------*/
    input.column {
        width: 70%;
    }

    textarea {
        width: 70%;
        height: 120px;
    }
    
    select {
        width: 70%;
        padding: 0;
    }

    div.contactB {
        width: 130px;
        margin-top: 40px;
        box-shadow: 0 2px 1px black;
    }
}
